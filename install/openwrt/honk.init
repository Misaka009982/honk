#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=01

# 安装包不自动启用服务，开机启动由 rc.d 链接控制。
start_service() {
	local config_file
	config_load honk
	config_get config_file config config_file /etc/honk/config.dae
	if [ ! -r "$config_file" ]; then
		logger -t honk "无法读取配置：$config_file"
		return 1
	fi
	if ubus call service list '{"name":"dae"}' 2>/dev/null |
		jsonfilter -q -e '@.dae.instances[*].running' | grep -q true; then
		logger -t honk '请先停止 dae，两者不能同时占用 dae0 与 daens'
		return 1
	fi
	if [ ! -r /sys/kernel/btf/vmlinux ] && [ ! -r /usr/lib/debug/boot/vmlinux ]; then
		logger -t honk '缺少内核 BTF，请从当前固件的软件源安装 vmlinux-btf'
		return 1
	fi
	mkdir -p /sys/fs/bpf
	grep -qs ' /sys/fs/bpf bpf ' /proc/mounts || mount -t bpf bpf /sys/fs/bpf || return 1
	procd_open_instance honk
	procd_set_param command /usr/bin/honk-core --config "$config_file"
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 60
	procd_close_instance
}

reload_service() {
	procd_running honk honk || return 0
	local config_file
	config_load honk
	config_get config_file config config_file /etc/honk/config.dae
	if ubus call service list '{"name":"honk"}' 2>/dev/null |
		jsonfilter -q -e '@.honk.instances.honk.command[*]' | grep -qxF -- "$config_file"; then
		/usr/bin/honk-core reload
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger honk
}
